# 仅监听 8788，使用 Caddy 内置 CA 为 SITE_HOST 签发自签名证书。
# SITE_HOST 必须是浏览器实际访问时使用的主机名或公网 IP。
{
	admin off
	# 不要关闭 auto_https：Caddy 需要它来为 IP 地址签发并管理内置 CA 证书。
	# 这里的站点显式使用 tls internal，不会向公网 CA 申请证书。

	# 浏览器用 IP 访问时不会发送 SNI，必须指定默认 SNI，
	# 否则 Caddy 找不到证书会直接断开 TLS 握手。
	default_sni {$SITE_HOST:localhost}
}

https://{$SITE_HOST:localhost}:8788 {
	tls internal

	encode zstd gzip

	header {
		# 隐藏后端技术栈信息
		-Server
	}

	reverse_proxy apiunit:8788 {
		# 覆盖客户端自带的转发头，确保后端登录限流拿到真实来源 IP
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
	}
}
