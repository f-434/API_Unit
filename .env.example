# 复制为 .env 后填写；.env 已被 .gitignore 忽略。
# 登录密码：建议 20 位以上随机字符，例如 openssl rand -base64 24
AUTH_PASSWORD=

# 浏览器实际访问使用的主机名或公网 IP，用于签发自签名证书。
# 只有公网 IP 时填公网 IP；访问地址将是 https://<SITE_HOST>:8788
SITE_HOST=

RETENTION_DAYS=30
MAX_CONCURRENT_RUNS=4

# 默认 false：拒绝把 API Key 通过明文 HTTP 发往公网地址。
# 仅当必须用 HTTP 访问公网上游时才改为 true。
ALLOW_INSECURE_UPSTREAM=false

TZ=Asia/Shanghai
